{
  "env": {
    "node": true,
    "es2021": true,
    "browser": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "warn",
    "no-empty": "warn",
    "no-console": "off",
    "semi": "off",
    "quotes": "off",
    "indent": "off",
    "no-multiple-empty-lines": "off",
    "eqeqeq": ["warn", "always"],
    "curly": "off"
  },
  "overrides": [
    {
      "files": ["*.jsx"],
      "parserOptions": {
        "ecmaFeatures": {
          "jsx": true
        }
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "no-undef": "warn",
        "no-empty": "warn"
      }
    }
  ]
}
