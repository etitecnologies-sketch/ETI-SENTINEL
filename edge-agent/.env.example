INGEST_API_URL=http://localhost:3000
COLLECTOR_KEY=
CLIENT_ID=
LOG_LEVEL=INFO
CHECK_TIMEOUT_SECONDS=6

# ── Módulos ativos ────────────────────────────────────────────────────────────
ENABLE_DEVICE_MONITOR=1
ENABLE_STREAMING=1
ENABLE_RTSP_MONITOR=0
ENABLE_ONVIF_COLLECTOR=1
ENABLE_DISCOVERY=1
ENABLE_AGENT_API=1

# Analíticos de vídeo com IA (requer bin/modelo_ia.onnx)
ENABLE_AI_ANALYTICS=0
ENABLE_AI_NARRATIVE=0
ANTHROPIC_API_KEY=

# Features avançadas de IA (requer ENABLE_AI_ANALYTICS=1)
ENABLE_DIRECTIONAL_COUNTER=0
ENABLE_FALL_DETECTION=0
ENABLE_HEATMAP=0
ENABLE_LOITERING=0
ENABLE_AUDIO_ANOMALY=0
ENABLE_PLATE_RECOGNITION=0
ENABLE_BEHAVIORAL_LEARNING=0

ENABLE_TRAY=0
ENABLE_RECORDING=0
AGENT_ID=

# ── Abandono de objeto ────────────────────────────────────────────────────────
AI_ABANDON_SECONDS=30
AI_ABANDON_CLASSES=backpack,suitcase,handbag,umbrella,bottle,cup
AI_ABANDON_PERSON_RADIUS=0.25

# ── Detecção de áudio anômalo ─────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SECONDS=1.0
AUDIO_SPIKE_FACTOR=4.0
AUDIO_BASELINE_ALPHA=0.05
AUDIO_EVENT_COOLDOWN_SECONDS=45
AUDIO_MAX_STREAMS=4

# ── Reconhecimento de placa veicular ─────────────────────────────────────────
AI_PLATE_WHITELIST=
AI_PLATE_BLACKLIST=
AI_PLATE_EVENT_COOLDOWN_SECONDS=120
AI_PLATE_MIN_CONF=0.4

# ── Aprendizado comportamental ────────────────────────────────────────────────
AI_BEHAVIOR_LEARN_DAYS=7
AI_BEHAVIOR_ANOMALY_FACTOR=3.0
AI_BEHAVIOR_WINDOW_MINUTES=30
AI_BEHAVIOR_STATE_FILE=

# ── Contador direcional de pessoas (Feature #7) ───────────────────────────────
# Linha virtual normalizada: "x1,y1,x2,y2" (0.0 a 1.0). Padrão: horizontal central.
AI_DIRECTION_LINE=0,0.5,1,0.5
# Lado que conta como entrada: "positive" (abaixo/direita) ou "negative" (acima/esquerda)
AI_DIRECTION_ENTER_SIDE=positive
AI_DIRECTION_TRACK_RADIUS=0.12
AI_DIRECTION_TRACK_TIMEOUT=3.0
AI_DIRECTION_PERSIST_FILE=

# ── Detecção de queda de pessoa (Feature #10) ─────────────────────────────────
# Proporção h/w da caixa: abaixo = caído, acima = de pé
AI_FALL_ASPECT_THRESHOLD=0.65
AI_FALL_STANDING_ASPECT=1.0
AI_FALL_SPEED_FRAMES=5
AI_FALL_TRACK_RADIUS=0.20
AI_FALL_TRACK_TIMEOUT=6.0
AI_FALL_ALERT_INTERVAL=90
AI_FALL_MIN_BOX_HEIGHT=0.08

# ── Mapa de calor de movimentação (Feature #9) ────────────────────────────────
AI_HEATMAP_INTERVAL_MINUTES=60
AI_HEATMAP_GRID_SIZE=64
AI_HEATMAP_BLUR_RADIUS=3
AI_HEATMAP_DECAY_FACTOR=0.85
AI_HEATMAP_MIN_DETECTIONS=10
AI_HEATMAP_OVERLAY_ALPHA=0.6
AI_HEATMAP_OUTPUT_PATH=

# ── Detecção de permanência prolongada (Feature #8) ───────────────────────────
# Zona de monitoramento "x1,y1,x2,y2" normalizados. Vazio = frame inteiro.
AI_LOITER_ZONE=
AI_LOITER_SECONDS=60
AI_LOITER_ALERT_INTERVAL=120
AI_LOITER_TRACK_RADIUS=0.15
AI_LOITER_TRACK_TIMEOUT=5.0

# ── Device monitoring ─────────────────────────────────────────────────────────
DEVICE_INTERVAL_SECONDS=10
DEVICE_WORKERS=30

REMOTE_REFRESH_SECONDS=60
DEFAULT_TIMEOUT_SECONDS=8
DEFAULT_INTERVAL_SECONDS=30

# ── Edge runtime ──────────────────────────────────────────────────────────────
EDGE_REFRESH_SECONDS=10
EDGE_FLUSH_SECONDS=5
EDGE_NOTIFY_LOG=0
EDGE_EVENT_DEDUPE_SECONDS=600
EDGE_VIDEOLOSS_CONFIRM_SECONDS=15
EDGE_RECOVERY_CONFIRM_SECONDS=10
EDGE_VIDEOLOSS_MIN_SECONDS=30
EDGE_NOTIFY_RECOVERY=0
EDGE_SUPPRESS_EVENT_TYPES=
EDGE_START_MEDIAMTX=1
STREAM_RESTART_COOLDOWN_SECONDS=60
STREAM_FORCE_TRANSCODE=0
STREAM_MAX_RETRIES=0
STREAM_RETRY_MAX_BACKOFF_SECONDS=60
TWILIO_WHATSAPP_NUMBER=
TWILIO_CONTENT_SID=

# ── ONVIF ─────────────────────────────────────────────────────────────────────
ONVIF_REMOTE=1
PULL_TIMEOUT_SECONDS=10
MESSAGE_LIMIT=10
RECONNECT_SECONDS=5

# ── Descoberta de dispositivos ────────────────────────────────────────────────
DISCOVERY_INTERVAL_SECONDS=300
DISCOVERY_MAX_HOSTS=512
DISCOVERY_WORKERS=120
DISCOVERY_PING_TIMEOUT_MS=700
DISCOVERY_PORT_TIMEOUT_S=0.25
DISCOVERY_PORTS=80,443,554,22,161,8080,8000,3000,8899
DISCOVERY_ONVIF_WS=1
DISCOVERY_WS_TIMEOUT_SECONDS=2
DISCOVERY_REQUIRE_PING=0
DISCOVERY_RESOLVE_DNS=1
DISCOVERY_INCLUDE_SELF=0
DISCOVERY_SUBNETS=

# ── Agent API ─────────────────────────────────────────────────────────────────
AGENT_API_BIND=127.0.0.1
AGENT_API_PORT=8808
AGENT_API_KEY=
EDGE_USE_PYTHONW=1
RECORD_BASE_DIR=
RECORD_SEGMENT_SECONDS=10
RECORD_REFRESH_SECONDS=60
CAMERA_DISCOVERY_AUTO_PUSH=1
CAMERA_REMOTE_CREDS=1
CAMERA_DEFAULT_USER=admin
CAMERA_DEFAULT_PASS=
CAMERA_SCAN_TIMEOUT=6
CAMERA_SCAN_WORKERS=32
CAMERA_MAX_CRED_TRIES=2

# ── Analíticos de IA — Motor ONNX (sem PyTorch) ───────────────────────────────
# Caminhos do modelo (gerado por exportar_modelo.py)
AI_ONNX_MODEL=
AI_ONNX_CLASSES=

# Classes e limiares
AI_CLASSES=person,car,motorcycle
AI_CONF_THRESHOLD=0.50
AI_NMS_THRESHOLD=0.45
AI_IMAGE_SIZE=640

# Filtros de qualidade (reduzem falsos positivos)
# Área mínima da caixa como % do frame (0.001 = 0.1% — ignora objetos minúsculos)
AI_MIN_BOX_AREA_PCT=0.001
# Frames consecutivos necessários para confirmar detecção antes de disparar alerta
AI_MIN_CONFIRM_FRAMES=2

# Ritmo de análise
AI_FRAME_EVERY_SECONDS=1.0
AI_EVENT_COOLDOWN_SECONDS=300
AI_STARTUP_DELAY_SECONDS=20
AI_RECONNECT_BACKOFF_SECONDS=5
AI_LOOP_SLEEP_SECONDS=0.3

# Snapshot junto ao alerta
AI_SEND_SNAPSHOT=1
AI_SNAPSHOT_MAX_WIDTH=1280
AI_SNAPSHOT_JPEG_QUALITY=90
AI_SNAPSHOT_MAX_BYTES=900000

# URL do stream: {stream_key} é substituído pelo identificador da câmera
AI_SOURCE_URL_TEMPLATE=rtsp://127.0.0.1:8554/{stream_key}

# Zonas de intrusão e linhas virtuais (JSON — configurar via painel)
AI_ZONES=
AI_CROSSING_LINES=
AI_PEOPLE_MAX_COUNT=0

# ── Analíticos de IA — Motor PyTorch/Ultralytics (legado) ────────────────────
AI_MODEL=yolov8s.pt
AI_PERSON_CONF_THRESHOLD=0.50
AI_VEHICLE_CONF_THRESHOLD=0.55
AI_CLASS_THRESHOLDS=
AI_MIN_AREA_RATIO=0.0008
AI_CLASS_MIN_AREA_RATIO=
AI_CONFIRM_FRAMES=1
AI_CONFIRM_WINDOW_SECONDS=1.0
AI_SNAPSHOT_MODE=ffmpeg_fallback
AI_SNAPSHOT_FFMPEG_TIMEOUT_SECONDS=4
AI_SNAPSHOT_FFMPEG_STIMEOUT_MS=2000
AI_DEVICE_IDS=
AI_SEVERITY_MAP=person=warn,car=info,motorcycle=info,bus=info,truck=info
AI_EVENT_PREFIX=ai_
AI_EVENT_SUFFIX=_detected
AI_GROUP_HUMAN_CLASSES=person
AI_GROUP_VEHICLE_CLASSES=car,motorcycle,bus,truck
AI_DEBUG_EVERY_SECONDS=10
AI_DEBUG_LOG=0
